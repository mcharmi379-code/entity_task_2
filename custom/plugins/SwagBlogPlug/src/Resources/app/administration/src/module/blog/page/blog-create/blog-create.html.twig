{% block swag_blog_create %}
<sw-page :isLoading="isLoading">

    <template #smart-bar-header>
        <h2>
            {{ $route.params.id ? 'Edit Blog' : 'Create Blog' }}
        </h2>
    </template>

    <template #smart-bar-actions>
        <sw-button variant="primary" @click="onSave">
            Save
        </sw-button>
    </template>

    <template #content>
        <sw-card title="General Information">

            <sw-text-field
                label="Name"
                v-model:value="blog.name" required>
            </sw-text-field>

            <sw-text-field
                label="Author" 
                v-model:value="blog.author">
            </sw-text-field>

            <sw-textarea-field
                label="Description"
                v-model:value="blog.description" required>
            </sw-textarea-field>

            <sw-datepicker
                label="Release Date"
                v-model:value="blog.releaseDate" required>
            </sw-datepicker>

            <sw-switch-field
                label="Active"
                v-model:value="blog.active" required>
            </sw-switch-field>

            <sw-entity-single-select
                label="Category"
                entity="swag_blog_category"
                v-model:value="blog.swagBlogCategoryId">
            </sw-entity-single-select>

           <sw-entity-multi-select
                label="Products"
                entity="product"
                :entity-collection="products"
                :criteria="productCriteria"
                :context="productContext"
                advanced-selection-component="sw-advanced-selection-product"
                @update:entity-collection="setProductCollection">
                <template #selection-label-property="{ item }">
                    <sw-product-variant-info :variations="item.variation">
                        {{ item.translated.name || item.name }}
                    </sw-product-variant-info>
                </template>

                <template #result-item="{ item, index, searchTerm, highlightSearchTerm, isSelected }">
                    <sw-select-result
                        :selected="isSelected(item)"
                        v-bind="{ item, index, searchTerm, highlightSearchTerm }">
                        <span class="sw-select-result__result-item-text">
                            <sw-product-variant-info
                                :variations="item.variation"
                                :highlighted="highlightSearchTerm"
                                :search-term="searchTerm"
                            >
                                {{ item.translated.name || item.name }}
                            </sw-product-variant-info>
                        </span>
                    </sw-select-result>
                </template>
            </sw-entity-multi-select>
        </sw-card>
    </template>

</sw-page>
{% endblock %}
