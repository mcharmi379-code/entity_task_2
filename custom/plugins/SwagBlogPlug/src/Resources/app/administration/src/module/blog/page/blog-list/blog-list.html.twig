{% block swag_blog_list %}
<sw-page>
    <template #smart-bar-header>
        <h2>Blog List</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button variant="primary" :routerLink="{ name: 'sw.blog.create' }">
            Add Blog
        </sw-button>
    </template>

    <template #content>
        <sw-entity-listing
            v-if="blogs"
            :items="blogs"
            :repository="repository"
            :showSelection="false"
            :columns="[
                { property: 'translated.name', label: 'Name' },
                { property: 'active', label: 'Active' },
                {# { property: 'releaseDate', label: 'Release Date' }, #}
                { property: 'translated.author', label: 'Author' }
            ]"
            detailRoute="sw.blog.detail"
            @delete-item="onDelete"
        >
        </sw-entity-listing>
    </template>
</sw-page>
{% endblock %}
